    public function showForm($ID, $options = []): bool
    {
        self::denyIfNoAdminRead();

        $this->initForm($ID, $options);

        if ($ID > 0) {
            $this->getFromDB($ID);
        } else {
            $this->fields['port']     = 55414;
            $this->fields['protocol'] = 'http';
            $this->fields['version']  = '2.5';
        }

        $canedit = self::canAdminUpdate();

        $options['target']  = self::getFormURL();
        $options['canedit'] = $canedit;
        $options['colspan'] = 4;

        $this->showFormHeader($options);

        echo Html::hidden('id', [
            'value' => (int) ($this->fields['id'] ?? 0),
        ]);

        echo Html::hidden('_glpi_csrf_token', [
            'value' => Session::getNewCSRFToken(),
        ]);

        $entity   = (int) ($this->fields['entities_id'] ?? ($_SESSION['glpiactive_entity'] ?? 0));
        $location = (int) ($this->fields['locations_id'] ?? 0);
        $protocol = (string) ($this->fields['protocol'] ?? 'http');
        $version  = UrbackupApiFactory::normalize((string) ($this->fields['version'] ?? '2.5'));

        echo "<tr class='tab_bg_1'>";
        echo "<td>" . self::h(__('Name')) . "</td>";
        echo "<td><input type='text' class='form-control' name='name' value='" . self::h((string) ($this->fields['name'] ?? '')) . "' required></td>";
        echo "<td>" . self::h(__('IP address', 'glurbackup')) . "</td>";
        echo "<td><input type='text' class='form-control' name='ip_address' value='" . self::h((string) ($this->fields['ip_address'] ?? '')) . "' required></td>";
        echo "</tr>";

        echo "<tr class='tab_bg_1'>";
        echo "<td>" . self::h(__('Port')) . "</td>";
        echo "<td><input type='number' min='1' max='65535' class='form-control' name='port' value='" . (int) ($this->fields['port'] ?? 55414) . "'></td>";
        echo "<td>" . self::h(__('Protocol', 'glurbackup')) . "</td>";
        echo "<td><select name='protocol' class='form-select'>";
        foreach (['http', 'https'] as $p) {
            echo "<option value='" . self::h($p) . "'" . ($protocol === $p ? ' selected' : '') . ">" . strtoupper($p) . "</option>";
        }
        echo "</select></td>";
        echo "</tr>";

        echo "<tr class='tab_bg_1'>";
        echo "<td>" . self::h(__('URBackup server version', 'glurbackup')) . "</td>";
        echo "<td>";
        echo "<select name='version' class='form-select'>";
        foreach (UrbackupApiFactory::getChoices() as $key => $label) {
            $selected = ($version === $key) ? ' selected' : '';
            echo "<option value='" . self::h($key) . "'" . $selected . ">" . self::h($label) . "</option>";
        }
        echo "</select>";
        echo "</td>";
        echo "<td>" . self::h(__('Username')) . "</td>";
        echo "<td><input type='text' class='form-control' name='username' value='" . self::h((string) ($this->fields['username'] ?? '')) . "'></td>";
        echo "</tr>";

        echo "<tr class='tab_bg_1'>";
        echo "<td>" . self::h(__('Password')) . "</td>";
        echo "<td><input type='password' class='form-control' name='password' value='" . self::h((string) ($this->fields['password'] ?? '')) . "'></td>";
        echo "<td>" . self::h(__('Entity')) . "</td>";
        echo "<td>";
        Dropdown::show('Entity', [
            'name'  => 'entities_id',
            'value' => $entity,
        ]);
        echo "</td>";
        echo "</tr>";

        echo "<tr class='tab_bg_1'>";
        echo "<td>" . self::h(__('Location')) . "</td>";
        echo "<td>";
        Dropdown::show('Location', [
            'name'  => 'locations_id',
            'value' => $location,
        ]);
        echo "</td>";
        echo "<td>" . self::h(__('Options')) . "</td>";
        echo "<td>";
        echo "<label class='me-4'><input type='checkbox' name='ignore_ssl' value='1'" . ((int) ($this->fields['ignore_ssl'] ?? 0) === 1 ? ' checked' : '') . "> " . self::h(__('Ignore SSL', 'glurbackup')) . "</label>";
        echo "<label class='me-4'><input type='checkbox' name='is_default' value='1'" . ((int) ($this->fields['is_default'] ?? 0) === 1 ? ' checked' : '') . "> " . self::h(__('Default', 'glurbackup')) . "</label>";
        echo "<label><input type='checkbox' name='is_recursive' value='1'" . ((int) ($this->fields['is_recursive'] ?? 0) === 1 ? ' checked' : '') . "> " . self::h(__('Recursive on child entities', 'glurbackup')) . "</label>";
        echo "</td>";
        echo "</tr>";

        echo "<tr class='tab_bg_1'>";
        echo "<td>" . self::h(__('Comments')) . "</td>";
        echo "<td colspan='3'><textarea name='comment' class='form-control' rows='4'>" . self::h((string) ($this->fields['comment'] ?? '')) . "</textarea></td>";
        echo "</tr>";

        echo "<tr>";
        echo "<td colspan='4' class='center'>";

        if ($canedit) {
            if ((int) ($this->fields['id'] ?? 0) > 0) {
                echo "<button type='submit' name='update' value='1' class='btn btn-primary me-2'>";
                echo self::h(__('Save'));
                echo "</button>";

                echo "<button type='submit' name='delete' value='1' class='btn btn-danger' ";
                echo "onclick='return confirm(\"" . addslashes(__('Are you sure?')) . "\")'>";
                echo self::h(__('Delete'));
                echo "</button>";
            } else {
                echo "<button type='submit' name='add' value='1' class='btn btn-primary'>";
                echo self::h(__('Add'));
                echo "</button>";
            }
        }

        echo "</td>";
        echo "</tr>";

        echo "</table>";

        if ((int) ($this->fields['id'] ?? 0) > 0) {
            $this->showLinkedComputersSection((int) $this->fields['id']);
        }

        echo "</form>";

        return true;
    }

    private function showLinkedComputersSection(int $serverId): void
    {
        global $CFG_GLPI;

        $rows = ComputerServer::getLinkedComputersForServer($serverId);

        echo "<div class='spaced'>";
        echo "<table class='tab_cadre_fixe'>";
        echo "<tr><th colspan='5'>" . self::h(__('Linked computers', 'glurbackup')) . "</th></tr>";
        echo "<tr>";
        echo "<th>" . self::h(__('Computer')) . "</th>";
        echo "<th>" . self::h(__('IP address', 'glurbackup')) . "</th>";
        echo "<th>" . self::h(__('URBackup client version', 'glurbackup')) . "</th>";
        echo "<th>" . self::h(__('Last file backup', 'glurbackup')) . "</th>";
        echo "<th>" . self::h(__('Last image backup', 'glurbackup')) . "</th>";
        echo "</tr>";

        if ($rows === []) {
            echo "<tr class='tab_bg_1'>";
            echo "<td colspan='5' class='center'>" . self::h(__('No computers linked to this server.', 'glurbackup')) . "</td>";
            echo "</tr>";
        } else {
            foreach ($rows as $row) {
                $computerId   = (int) ($row['computers_id'] ?? 0);
                $computerName = (string) ($row['name'] ?? '');

                if ($computerId > 0 && $computerName !== '') {
                    $computerUrl  = $CFG_GLPI['root_doc'] . '/front/computer.form.php?id=' . $computerId;
                    $computerLink = "<a href='" . self::h($computerUrl) . "'>" . self::h($computerName) . "</a>";
                } else {
                    $computerLink = self::h($computerName);
                }

                echo "<tr class='tab_bg_1'>";
                echo "<td>" . $computerLink . "</td>";
                echo "<td>" . self::h((string) $row['ip_address']) . "</td>";
                echo "<td>" . self::h((string) $row['client_version']) . "</td>";
                echo "<td>" . self::h((string) $row['last_file_backup']) . "</td>";
                echo "<td>" . self::h((string) $row['last_image_backup']) . "</td>";
                echo "</tr>";
            }
        }

        echo "</table>";
        echo "</div>";
    }

    private static function encryptSecret(string $plain): string
    {
        if ($plain === '') {
            return '';
        }

        if (!function_exists('openssl_encrypt')) {
            return base64_encode($plain);
        }

        $key = hash('sha256', self::getCryptoKey(), true);
        $iv  = random_bytes(16);

        $cipher = openssl_encrypt(
            $plain,
            'AES-256-CBC',
            $key,
            OPENSSL_RAW_DATA,
            $iv
        );

        if ($cipher === false) {
            return base64_encode($plain);
        }

        return base64_encode($iv . $cipher);
    }

    private static function decryptSecret(string $encoded): string
    {
        if ($encoded === '') {
            return '';
        }

        $raw = base64_decode($encoded, true);
        if ($raw === false) {
            return '';
        }

        if (!function_exists('openssl_decrypt')) {
            return $raw;
        }

        if (strlen($raw) < 17) {
            return $raw;
        }

        $iv     = substr($raw, 0, 16);
        $cipher = substr($raw, 16);
        $key    = hash('sha256', self::getCryptoKey(), true);

        $plain = openssl_decrypt(
            $cipher,
            'AES-256-CBC',
            $key,
            OPENSSL_RAW_DATA,
            $iv
        );

        return $plain === false ? '' : $plain;
    }

    private static function getCryptoKey(): string
    {
        if (defined('GLPIKEY')) {
            return (string) GLPIKEY;
        }

        if (defined('GLPI_CONFIG_DIR')) {
            return 'glurbackup|' . GLPI_CONFIG_DIR;
        }

        return 'glurbackup|fallback-key';
    }
}

// Wrapper legacy globale compatibile con front/server.php e Search::show()
if (!class_exists('PluginGlurbackupServer', false)) {
    class_alias(__NAMESPACE__ . '\\Server', 'PluginGlurbackupServer');
}

